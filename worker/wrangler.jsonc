{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feed-saas-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FEEDS"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
